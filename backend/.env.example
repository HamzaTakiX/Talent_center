# ----- Core -----
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://talent-center.localhost:5173,http://localhost:5173
# Production (Railway): exact Vercel URL, no trailing slash
# FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_RESET_PASSWORD_URL=http://talent-center.localhost:5173/reset-password

# ----- Backend public URL (media/avatars in production) -----
# PUBLIC_BACKEND_URL=https://talentcenter-production.up.railway.app

# ----- Database -----
# Use the SAME Railway Postgres URL locally and in production (Users tab → Connect).
# Public URL (proxy) for local dev; Railway backend uses DATABASE_URL reference (internal host).
# Same database name → users created locally appear in production.
DATABASE_URL=postgresql://REPLACE_WITH_RAILWAY_PUBLIC_CONNECT_URL

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@talent-center.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ----- Notifications -----
NOTIFICATION_EMAIL_PROVIDER=mock
BREVO_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@talent-center.local
SENDGRID_FROM_NAME=Digital Talent Center
FRONTEND_BASE_URL=http://talent-center.localhost:5173
NOTIFICATIONS_EMAIL_ENABLED=True
NOTIFICATIONS_IN_APP_ENABLED=True
NOTIFICATIONS_DIGEST_ENABLED=True
REDIS_URL=

# ----- Auth policy -----
# Use 0 for AUTH_LOCKOUT_SECONDS / AUTH_MAX_FAILED_ATTEMPTS to disable login lockout (local dev).
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILED_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- Providers (remote providers default OFF) -----
AUTH0_ENABLED=True
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_REDIRECT_URI=http://talent-center.localhost:5173/callback
AUTH0_JIT=True

# Demo: Microsoft Social Login goes through Auth0 (AUTH0_* above), not MS_* below.
# MS_* is for direct Azure AD / Entra ID SSO — not used for this demo.
MS_ENABLED=False
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
MS_JIT=True

# ----- Microsoft Graph (Enterprise App assignment; backend only) -----
# App registration: Talent Center Backend Graph (client credentials).
# Never put the client secret in frontend code or API responses.
MICROSOFT_GRAPH_ENABLED=False
MICROSOFT_GRAPH_TENANT_ID=eeea001e-d92d-4351-950b-15213b8df09e
MICROSOFT_GRAPH_CLIENT_ID=17d73b8c-3214-4b13-87ba-b3b4318c6c64
MICROSOFT_GRAPH_CLIENT_SECRET=
# Enterprise Application "Talent Center Auth0 Demo" → Object ID (service principal),
# NOT the App Registration client ID (2a413e06-...).
MICROSOFT_TALENT_CENTER_ENTERPRISE_APP_OBJECT_ID=
# Optional. Leave empty to resolve from Graph appRoles; otherwise set explicitly.
# If the Enterprise App has no custom roles, Microsoft Default Access is used:
# 00000000-0000-0000-0000-000000000000
MICROSOFT_TALENT_CENTER_APP_ROLE_ID=
#
# Required Graph application permissions (admin consent):
# - AppRoleAssignment.ReadWrite.All  (assign Users and groups on the Enterprise App)
# - User.Read.All                    (find users)
# - User.Invite.All                  (auto-invite guests when email is not in Entra yet)
#   (User.ReadWrite.All also works instead of User.Invite.All)

SSO_ENABLED=False
SSO_METADATA_URL=
SSO_JIT=False
