# ----- Core -----
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# Production (Railway): exact Vercel URL, no trailing slash
# FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# ----- Backend public URL (media/avatars in production) -----
# PUBLIC_BACKEND_URL=https://talentcenter-production.up.railway.app

# ----- Database -----
# Use the SAME Railway Postgres URL locally and in production (Users tab → Connect).
# Public URL (proxy) for local dev; Railway backend uses DATABASE_URL reference (internal host).
# Same database name → users created locally appear in production.
DATABASE_URL=postgresql://REPLACE_WITH_RAILWAY_PUBLIC_CONNECT_URL
# SQLite only if DATABASE_URL is unset AND DEBUG=True (do not use for shared prod data).

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@talent-center.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ----- Auth policy -----
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILED_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- Providers (remote providers default OFF) -----
AUTH0_ENABLED=True
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_spa_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_REDIRECT_URI=http://localhost:5173/callback
AUTH0_JIT=True

MS_ENABLED=False
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
MS_JIT=True

SSO_ENABLED=False
SSO_METADATA_URL=
SSO_JIT=False
