# Public app origin (no trailing slash). Local Auth0-friendly hostname:
# Auth0 treats *.localhost as verifiable → no "Authorize App" confirmation.
# Open the app at this URL (not plain http://localhost:5173).
VITE_APP_URL=http://talent-center.localhost:5173

# API backend (required)
# Railway backend base (must end with /api, no trailing slash after api)
# Login URL = {VITE_API_URL}/auth/login
# VITE_API_URL=https://talentcenter-production.up.railway.app/api
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: backend origin for /media/ avatar URLs (defaults to VITE_API_URL without /api)
# VITE_BACKEND_URL=https://talentcenter-production.up.railway.app


# Auth0 SPA — set the same values in Vercel → Project → Settings → Environment Variables
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id

# Optional: custom API audience (only if configured in Auth0 dashboard)
# VITE_AUTH0_AUDIENCE=

# Auth0 Microsoft Social connection name (Authentication → Social → Microsoft)
# Default for Microsoft Account Social: windowslive
VITE_AUTH0_CONNECTION=windowslive
#
# Auth0 Dashboard (manual) — add alongside existing localhost URLs until verified:
#   Allowed Callback URLs:  {VITE_APP_URL}/callback
#   Allowed Web Origins:    {VITE_APP_URL}
#   Allowed Logout URLs:    {VITE_APP_URL}
#     (must match logout returnTo exactly — app uses origin, not /login)
#     Also add http://localhost:5173 if you still open that host.
# Keep connection = windowslive. Do not request prompt=consent / prompt=login.
# Application should remain First-Party. Do not disable Non-Verifiable Callback
# confirmation globally for production — *.localhost already skips that prompt.

# Dev-only helpers (never commit secrets)
# VITE_DEV_STUDENT_PASSWORD=
# VITE_FRONTEND_ONLY_ADMIN=false
