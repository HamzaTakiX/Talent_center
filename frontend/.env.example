# API backend (required)
# Railway backend base (must end with /api, no trailing slash after api)
# VITE_API_URL=https://your-service.up.railway.app/api
VITE_API_URL=http://localhost:8000/api


# Auth0 SPA — set the same values in Vercel → Project → Settings → Environment Variables
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id

# Optional: custom API audience (only if configured in Auth0 dashboard)
# VITE_AUTH0_AUDIENCE=

# Dev-only helpers (never commit secrets)
# VITE_DEV_STUDENT_PASSWORD=
# VITE_FRONTEND_ONLY_ADMIN=false
